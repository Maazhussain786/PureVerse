<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Some HLS streams / embeds serve segments over http; allow cleartext so
         video isn't broken by mixed-content blocking. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
