PORT=5000

# TMDB — required. Use the v4 Read Access Token (Bearer), not the v3 key.
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token_here
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
JIKAN_BASE_URL=https://api.jikan.moe/v4

# Google Sign-In — required only if you enable Google auth on the web app.
# Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID on the frontend. Leave blank to
# allow guest sign-in only.
GOOGLE_CLIENT_ID=

# Optional outbound proxy for the anime scrapers (evades provider IP bans).
SCRAPER_PROXY_URL=

# Direct anime scraper (aniwatch / HiAnime). OFF by default because aniwatch is
# currently out of sync with the live site. Set true to re-enable the native
# SUB/DUB path; if it works, anime uses direct HLS, else it falls back to embeds.
ENABLE_HIANIME=false

# HiAnime domain used by the direct anime scraper (aniwatch). HiAnime rotates
# domains, so override here whenever the current one stops working. Code
# defaults to hianime.to. Known mirrors: hianimez.to, hianime.nz, hianime.pe.
ANIWATCH_DOMAIN=hianime.to
